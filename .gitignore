# =========================
# C++ 编译生成文件
# =========================
*.o
*.obj
*.exe
*.out
*.app
*.so
*.dylib
*.dll
*.lib
*.a

# =========================
# CMake 缓存与中间文件
# =========================
CMakeCache.txt
CMakeFiles/
CMakeScripts/
Makefile
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
_deps/

# 忽略你的 out-of-source 构建目录
build/
bin/
lib/

# =========================
# VS Code 配置文件
# =========================
# 忽略大部分本地工作区缓存和数据库
.vscode/*
# 但保留这几个核心配置文件，方便在不同设备上同步调试环境
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/c_cpp_properties.json
*.code-workspace
.history/

# =========================
# 操作系统生成文件
# =========================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# =========================
# 数据文件夹 (按需开启)
# =========================
# 如果你的 data 文件夹里有非常大的测试视频或图片，可以取消下面几行的注释
# data/*.mp4
# data/*.avi
# data/output/

# =========================
# LaTeX 编译缓存
# =========================
*.aux
*.log
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.bbl
*.blg
*.bcf
*.run.xml
*.xdv

# =========================
# 大作业局部生成文件
# =========================
final_projects/**/build/
final_projects/**/outputs/
final_projects/**/__pycache__/
final_projects/**/.pytest_cache/
final_projects/**/debug_masks*/
final_projects/**/test_output.txt
final_projects/**/out.txt

# Project 1 保留小训练集和 KNN 模型，但忽略额外大测试集
final_projects/project1_traditional_gesture/test_images/

# Project 2 只保留必要 checkpoint 与空目录占位，不提交重复数据集
final_projects/project2_deep_gesture/Hand_Posture_Hard_Stu/
final_projects/project2_deep_gesture/data/raw/*
final_projects/project2_deep_gesture/data/train/*
final_projects/project2_deep_gesture/data/val/*
!final_projects/project2_deep_gesture/data/raw/.gitkeep
!final_projects/project2_deep_gesture/data/train/.gitkeep
!final_projects/project2_deep_gesture/data/val/.gitkeep
final_projects/project2_deep_gesture/test_images/*
!final_projects/project2_deep_gesture/test_images/.gitkeep
final_projects/project2_deep_gesture/checkpoints/*
!final_projects/project2_deep_gesture/checkpoints/best_model.pth
